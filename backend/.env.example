# BrewCo CRM — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# -------------------------------------------------------
# DATABASE
# -------------------------------------------------------
# Neon PostgreSQL connection string (production/deployed or persistent).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Dedicated connection string for local development resets and synthetic seeding.
# Destructive utilities (reset_dev_db.py, seed.py) strictly require this variable,
# enforce local loopback hosts (localhost, 127.0.0.1, ::1), and refuse to run against
# remote databases to prevent accidental data loss.
DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brewco_dev

# -------------------------------------------------------
# AI / GROQ
# -------------------------------------------------------
GROQ_API_KEY=gsk_...

# -------------------------------------------------------
# CHANNEL SERVICE
# -------------------------------------------------------
# URL of the channel service /send endpoint.
CHANNEL_SERVICE_URL=http://localhost:8001/send

# Shared secret used to authenticate calls between the CRM
# backend and the channel service.  Must match the value
# configured in the channel service's .env file.
# Generate a strong value: python -c "import secrets; print(secrets.token_hex(32))"
CHANNEL_SERVICE_SECRET=

# URL where the channel service should POST delivery receipts.
CRM_RECEIPT_URL=http://localhost:8000/receipt

# -------------------------------------------------------
# CLERK AUTHENTICATION
# -------------------------------------------------------
# Clerk JWKS endpoint — required. Found in the Clerk dashboard:
#   API Keys → Advanced → JWT public key → JWKS URL
CLERK_JWKS_URL=https://<your-clerk-instance>.clerk.accounts.dev/.well-known/jwks.json

# Clerk token issuer — required. Must match the `iss` claim in
# session tokens for your Clerk instance.
CLERK_ISSUER=https://<your-clerk-instance>.clerk.accounts.dev

# -------------------------------------------------------
# CORS — allowed frontend origins
# -------------------------------------------------------
# Comma-separated list of frontend origins permitted to make
# credentialed (cookie/bearer) requests to this API.
# For local development, http://localhost:5173 is the Vite default.
# In production, set to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173

# -------------------------------------------------------
# ENVIRONMENT
# -------------------------------------------------------
# Set to 'production' in deployed environments (e.g. Render).
# Defaults to 'development'.
APP_ENV=development

# -------------------------------------------------------
# CLERK — authorized-party (azp) validation
# -------------------------------------------------------
# Comma-separated list of frontend origins permitted in the
# `azp` claim of Clerk session tokens.
# Defaults to the value of ALLOWED_ORIGINS (e.g. http://localhost:5173).
# In production (APP_ENV=production), ALLOWED_ORIGINS or
# CLERK_AUTHORIZED_PARTIES must be explicitly configured to prevent
# localhost fallback:
#   CLERK_AUTHORIZED_PARTIES=https://brewco.vercel.app
CLERK_AUTHORIZED_PARTIES=
