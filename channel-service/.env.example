# BrewCo CRM — Channel Service environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# -------------------------------------------------------
# SHARED SECRET
# -------------------------------------------------------
# The channel service validates this on every /send request.
# Must be identical to CHANNEL_SERVICE_SECRET in backend/.env.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CHANNEL_SERVICE_SECRET=

# -------------------------------------------------------
# CALLBACK URL
# -------------------------------------------------------
# Where to POST delivery receipts (the CRM backend /receipt endpoint).
CRM_RECEIPT_URL=http://localhost:8000/receipt
